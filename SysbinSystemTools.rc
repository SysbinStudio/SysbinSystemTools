#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// Icon
//
IDI_SYSBIN              ICON                    "sysbin.ico"

/////////////////////////////////////////////////////////////////////////////
// Manifest (UAC admin + Common Controls v6)
//
1                       RT_MANIFEST             "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Main dialog
//
IDD_MAIN DIALOGEX 0, 0, 520, 422
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
CAPTION "Sysbin System Tools  v1.0"
FONT 9, "Microsoft YaHei UI", 0, 0, 0x86
BEGIN
    CONTROL         "", IDC_TAB, "SysTabControl32", TCS_FOCUSNEVER | TCS_MULTILINE | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS, 0, 0, 520, 392
    CTEXT           "", IDC_STATUS, 8, 396, 504, 20, SS_SUNKEN | NOT WS_GROUP
END

/////////////////////////////////////////////////////////////////////////////
// Memory page
//
IDD_PAGE_MEM DIALOGEX 0, 0, 500, 360
STYLE DS_SETFONT | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Microsoft YaHei UI", 0, 0, 0x86
BEGIN
    GROUPBOX        "物理内存状态", IDC_MEM_GROUP, 8, 6, 484, 112
    LTEXT           "总物理内存", IDC_STATIC, 22, 28, 76, 14
    RTEXT           "--", IDC_MEM_TOTAL, 104, 28, 140, 14, SS_SUNKEN
    LTEXT           "可用内存", IDC_STATIC, 268, 28, 64, 14
    RTEXT           "--", IDC_MEM_AVAIL, 336, 28, 140, 14, SS_SUNKEN
    LTEXT           "内存使用率", IDC_STATIC, 22, 54, 76, 14
    RTEXT           "--", IDC_MEM_USAGE, 104, 54, 140, 14, SS_SUNKEN
    LTEXT           "建议：整理后仍被占用的内存属于正在使用的进程，属正常现象。", IDC_MEM_HINT, 268, 52, 210, 28
    CONTROL         "", IDC_MEM_PROGRESS, "msctls_progress32", PBS_SMOOTH | WS_CHILD | WS_VISIBLE, 22, 86, 454, 18
    PUSHBUTTON      "刷新状态", IDC_MEM_REFRESH, 8, 124, 92, 26
    PUSHBUTTON      "一键释放内存", IDC_MEM_RELEASE, 108, 124, 140, 26
    PUSHBUTTON      "清空日志", IDC_MEM_CLEARLOG, 256, 124, 92, 26
    LTEXT           "整理进程工作集 + 清理系统文件缓存（需要管理员权限）", IDC_MEM_HINT2, 358, 128, 134, 22
    LISTBOX         IDC_MEM_LOG, 8, 158, 484, 194, LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
END

/////////////////////////////////////////////////////////////////////////////
// Disk cleanup page
//
IDD_PAGE_DISK DIALOGEX 0, 0, 500, 360
STYLE DS_SETFONT | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Microsoft YaHei UI", 0, 0, 0x86
BEGIN
    LTEXT           "清理磁盘：", IDC_STATIC, 16, 11, 56, 14
    COMBOBOX        IDC_DISK_DRIVE, 76, 8, 164, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CTEXT           "扫描结果：--", IDC_DISK_SUMMARY, 248, 8, 236, 18, SS_SUNKEN
    AUTOCHECKBOX    "自动识别垃圾文件（读内容识别构建产物；跳过需联网恢复的依赖/工具目录）", IDC_CK_JUNKSCAN, 16, 32, 468, 18
    AUTOCHECKBOX    "用户临时文件 (%TEMP%)", IDC_CK_TEMP, 16, 56, 222, 18
    AUTOCHECKBOX    "系统临时文件 (Windows\\Temp)", IDC_CK_WINTEMP, 248, 56, 236, 18
    AUTOCHECKBOX    "回收站", IDC_CK_RECYCLE, 16, 80, 222, 18
    AUTOCHECKBOX    "Prefetch 预读缓存", IDC_CK_PREFETCH, 248, 80, 236, 18
    AUTOCHECKBOX    "缩略图缓存", IDC_CK_THUMBS, 16, 104, 222, 18
    AUTOCHECKBOX    "浏览器缓存 (Chrome / Edge / Firefox)", IDC_CK_BROWSER, 248, 104, 236, 18
    AUTOCHECKBOX    "Windows 更新缓存", IDC_CK_UPDATE, 16, 128, 222, 18
    LTEXT           "提示：固定项目主要在系统盘；勾选自动识别可扫描任意磁盘上的散落垃圾文件。", IDC_STATIC, 248, 128, 236, 18
    PUSHBUTTON      "扫描", IDC_DISK_SCAN, 16, 152, 92, 26
    PUSHBUTTON      "开始清理", IDC_DISK_CLEAN, 116, 152, 110, 26
    PUSHBUTTON      "全选", IDC_DISK_SELECTALL, 234, 152, 62, 26
    PUSHBUTTON      "全不选", IDC_DISK_SELECTNONE, 304, 152, 62, 26
    PUSHBUTTON      "清空日志", IDC_DISK_CLEARLOG, 374, 152, 110, 26
    LISTBOX         IDC_DISK_LOG, 8, 186, 484, 166, LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
END

/////////////////////////////////////////////////////////////////////////////
// Hosts page
//
IDD_PAGE_HOSTS DIALOGEX 0, 0, 500, 372
STYLE DS_SETFONT | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Microsoft YaHei UI", 0, 0, 0x86
BEGIN
    CONTROL         "", IDC_HOSTS_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 8, 484, 160
    PUSHBUTTON      "应用所选加速", IDC_HOSTS_APPLY, 8, 174, 88, 26
    PUSHBUTTON      "立即查询", IDC_HOSTS_QUERY, 100, 174, 72, 26
    PUSHBUTTON      "还原原始 Hosts", IDC_HOSTS_RESTORE, 176, 174, 92, 26
    PUSHBUTTON      "刷新 DNS", IDC_HOSTS_FLUSHDNS, 272, 174, 68, 26
    PUSHBUTTON      "测试延迟", IDC_HOSTS_PING, 344, 174, 64, 26
    PUSHBUTTON      "打开 Hosts", IDC_HOSTS_OPEN, 412, 174, 80, 26
    AUTOCHECKBOX    "自动解析域名 IP（DoH，绕过本地 DNS 污染）", IDC_HOSTS_AUTO, 10, 208, 240, 16
    LTEXT           "DoH 服务器:", IDC_STATIC, 256, 209, 66, 14
    COMBOBOX        IDC_HOSTS_DOH, 322, 206, 170, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "实时侦测 DNS 变化并自动更新 Hosts（每 60 秒检查一次）", IDC_HOSTS_WATCH, 10, 228, 480, 16
    LTEXT           "自定义条目（每行一条：IP 域名，例如 1.2.3.4 example.com；IP 写 auto 表示自动解析）", IDC_HOSTS_HINT, 10, 250, 480, 16
    EDITTEXT        IDC_HOSTS_CUSTOM, 8, 268, 484, 70, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    CTEXT           "", IDC_HOSTS_STATUS, 8, 344, 484, 20, SS_SUNKEN | NOT WS_GROUP
END
